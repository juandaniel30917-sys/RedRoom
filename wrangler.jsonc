{
  // REDROOM · configuración del Worker (Cloudflare)
  "name": "redroom",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/admin/api/*", "/data/contenido.js", "/media/*"]
  },
  "kv_namespaces": [
    { "binding": "RR_KV", "id": "b7098bbac539438fadfc1a70242b1e62" }
  ],
  "vars": {
    // Cloudflare Access: equipo y AUD de la aplicación que protege redroomchile.cl/admin
    "TEAM_DOMAIN": "https://noisy-queen-8049.cloudflareaccess.com",
    "POLICY_AUD": "f158a7d1d90960056220a573244890f716dff7460f9a5c935bb92c04f5a95259"
  }
}
